# Copy this file to `.env` and fill it in. Never commit `.env` — it holds secrets.

# --- Required ---
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# --- Minecraft RCON (needed for server status, /link, playtime XP, giveaways auto-entry, etc.) ---
# Must match enable-rcon / rcon.port / rcon.password in the Minecraft server.properties
RCON_IP=localhost
RCON_PORT=25575
RCON_PASS=

# --- Optional: leave empty to turn the feature off ---
# Second bot account that runs the mini-games (/trivia, /minesweeper)
MINIGAME_DISCORD_TOKEN=
# Google Gemini key for the AI helper in support tickets (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# CurseForge API key for modpack update announcements (https://console.curseforge.com/)
CURSEFORGE_API_KEY=
